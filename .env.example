APP_URL=http://localhost:3001
APP_PORT=3001
APP_KEY=
APP_PREVIOUS_KEY=

# PostgreSQL and Redis run on the host machine (not in Docker).
# From inside the container reach them via host.docker.internal (= 172.27.0.1).
DATABASE_URL=postgresql://cakadi:cakadi@host.docker.internal:5432/cakadi_cv
REDIS_URL=redis://host.docker.internal:6379/0

# When running directly on the host with `bun run dev`, use instead:
# DATABASE_URL=postgresql://cakadi:cakadi@127.0.0.1:5432/cakadi_cv
# REDIS_URL=redis://127.0.0.1:6379/0

# Mailpit on the host (SMTP 1025, web UI 8025). Use 127.0.0.1 for `bun run dev`.
MAIL_MAILER=smtp
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=admin@masadi.net
MAIL_FROM_NAME=Cakadi CV

NUXT_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
