APP_URL=http://localhost:3001
APP_PORT=3001
APP_KEY=
APP_PREVIOUS_KEY=

# Redis runs on the host machine (not in Docker).
# From inside the container reach it via host.docker.internal (= 172.27.0.1).
REDIS_URL=redis://host.docker.internal:6379/0

# When running directly on the host with `bun run dev`, use instead:
# REDIS_URL=redis://127.0.0.1:6379/0

# MongoDB (Prisma 8 target) — runs natively on the production host, shared
# with vettrak's mongod instance (see vettrak/docs/mongodb-native-setup.md),
# each app scoped to its own database + user. Needs a replica set (rs0)
# even locally, since Prisma 8's Mongo target requires one for transactions.
# In production, lombacv-blue/green sit on their own user-defined network
# (lombacv-net) with fixed IPs, but reach mongod via mongo-net's gateway
# (172.20.0.1) — shared with vettrak, since a replica set can only
# advertise one host for its member. When running on the host with
# `bun run dev`, use 127.0.0.1.
MONGODB_URL=

# Mailpit on the host (SMTP 1025, web UI 8025). Use 127.0.0.1 for `bun run dev`.
MAIL_MAILER=smtp
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=admin@masadi.net
MAIL_FROM_NAME=Cakadi CV

NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
