{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "prisma contract emit && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "prisma contract emit && nuxt prepare",
    "seed": "bun prisma/seed.ts",
    "seed:fresh": "bun prisma/seed.ts",
    "key:generate": "bun server/scripts/key.ts generate",
    "key:show": "bun server/scripts/key.ts show",
    "key:status": "bun server/scripts/key.ts status",
    "key:rotate-fix": "bun server/scripts/key.ts rotate-fix",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f lombacv-blue",
    "db:migrate": "prisma db migrate --advance-ref db",
    "format": "biome format --write .",
    "lint": "biome check .",
    "contract:emit": "prisma contract emit"
  },
