  {
    "id": "index.portfolios.create(slug:1)",
    "label": "Create index on portfolios (slug:1)",
    "operationClass": "additive",
    "precheck": [
      {
        "description": "index does not already exist on portfolios",
        "source": {
          "kind": "listIndexes",
          "collection": "portfolios"
        },
        "filter": {
          "kind": "field",
          "field": "key",
          "op": "$eq",
          "value": {
            "slug": 1
          }
        },
        "expect": "notExists"
      }
    ],
    "execute": [
      {
        "description": "create index on portfolios",
        "command": {
          "kind": "createIndex",
          "collection": "portfolios",
          "keys": [
            {
              "direction": 1,
              "field": "slug"
            }
          ],
          "unique": true,
          "name": "slug_1"
        }
      }
    ],
    "postcheck": [
      {
        "description": "index exists on portfolios",
        "source": {
          "kind": "listIndexes",
          "collection": "portfolios"
        },
        "filter": {
          "kind": "and",
          "exprs": [
            {
              "kind": "field",
              "field": "key",
              "op": "$eq",
              "value": {
                "slug": 1
              }
            },
            {
              "kind": "field",
              "field": "unique",
              "op": "$eq",
              "value": true
            }
          ]
        },
        "expect": "exists"
      }
    ]
  },
